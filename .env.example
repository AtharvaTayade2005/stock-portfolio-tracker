# Server Port
PORT=4000

# Optional: Finnhub API Key for Live US Equities & Crypto WebSocket Feed
# If omitted, the server runs in Deterministic Market Replay Mode (1x / 5x / 10x)
FINNHUB_API_KEY=

# Optional: Google Gemini API Key for Live AI Portfolio Risk & News Copilot (gemini-3.8-flash)
# If omitted, falls back to the Deterministic Quantitative Stress-Test Engine
GEMINI_API_KEY=

# SQLite Database File Path (WAL Mode enabled automatically)
SQLITE_DB_PATH=./data/portfolio.sqlite
