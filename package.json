{
  "name": "stock-portfolio-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-Time Stock Portfolio Tracker with WebSocket Fan-Out, Market Replay, ACID FIFO Ledger, Web Worker Technical Indicators, and Gemini AI Risk Copilot",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "test": "node --import tsx --test tests/engine.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
